{
  "name": "wib",
  "version": "0.9.0",
  "description": "Time tracking tool for the cli",
  "keywords": [
    "tracker",
    "cli",
    "time tracking"
  ],
  "author": "Alexander Wink <wib@jinnoflife.com> (https://github.com/jinnoflife)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinnoflife/wib.git"
  },
  "bugs": {
    "url": "https://github.com/jinnoflife/wib/issues"
  },
  "homepage": "https://github.com/jinnoflife/wib#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/Wib.ts",
  "directories": {
    "bin": "./bin",
    "dist": "./dist",
    "lib": "./src",
    "test": "./tests"
  },
  "bin": {
    "wib": "./bin/index.js"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "inversify": "^7.5.0",
    "reflect-metadata": "^0.2.2",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.25"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.1",
    "@eslint/js": "^9.31.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.5",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "globals": "^16.3.0",
    "prettier": "^3.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.38.0"
  },
  "scripts": {
    "command:exec:start": "npm run wib",
    "command:exec:rebuild": "npm run tsc && npm run wib",
    "quality:lint": "npx eslint",
    "quality:fix": "npx eslint --fix",
    "build": "rm -rf ./dist; npm run tsc && cp -r ./src/messages ./dist/",
    "tsc": "./node_modules/.bin/tsc",
    "dev": "./node_modules/.bin/tsc --watch & node dist",
    "wib": "node ./bin/index.js",
    "link": "npm run build && npm link --force",
    "typeorm": "ts-node ./node_modules/typeorm/cli",
    "typeorm:migration:run-all": "npm run typeorm migration:run -- -d ./src/OrmDataSource.ts",
    "typeorm:migration:generate": "npm run typeorm -- migration:generate ./src/orm/migrations/$npm_config_name -d ./src/OrmDataSource.ts",
    "typeorm:migration:create": "npm run typeorm -- migration:create ./src/orm/migrations/$npm_config_name",
    "typeorm:migration:revert": "npm run typeorm -- migration:revert -d ./src/OrmDataSource.ts",
    "typeorm:initialize": "npx typeorm schema:drop -d dist/OrmDataSource.js && npm run typeorm:migration:run-all"
  },
  "nyc": {
    "extension": [
      ".ts",
      ".tsx"
    ],
    "include": [
      "src/**/*"
    ],
    "exclude": [
      "**/*.d.ts"
    ],
    "reporter": [
      "html",
      "text"
    ],
    "all": true
  }
}
